# Telegram
BOT_TOKEN=123456789:AA...              # từ @BotFather
APP_URL=https://your-app.up.railway.app   # domain Railway cấp, KHÔNG có dấu / cuối
ADMIN_IDS=111111111,222222222          # Telegram numeric id của admin, cách nhau bằng dấu phẩy

# Database (Railway Postgres plugin tự cấp biến này)
DATABASE_URL=postgresql://user:pass@host:5432/db

# Postback bảo mật cho Monetag S2S callback
POSTBACK_SECRET=chuoi-bi-mat-tu-dat
